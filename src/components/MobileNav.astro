---
/**
 * Mobile navigation — a fixed right-side drawer with drill-down panels.
 *
 * Ported from the sibling Cogdell Law site, in Cohen & Jaffe's brand. It
 * replaces an earlier drop-down whose sub-menus were nested `<details>`
 * accordions: with 62 links, a deep section became a very long scroll.
 *
 * Every level is a separate `<ul>` absolutely positioned in the same box, all
 * parked at `translateX(100%)` except `root`. Drilling adds `.is-open` to the
 * child panel so it slides in *over* its parent — the parent does not move.
 * A `stack` of panel ids in the script is the whole state model.
 *
 * MUST be rendered as a sibling of `<header>`, never inside it: `.site-header`
 * is `position: relative; z-index: var(--z-header)` and so creates a stacking
 * context that would trap this fixed drawer at z-index 100.
 */
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-white.png";
import { FIRM, type NavItem } from "../data/navigation";
import { isWithin } from "../lib/urls";

interface Props {
  items: NavItem[];
  pathname: string;
}

const { items, pathname } = Astro.props;

/**
 * Flatten the nav tree into sibling panels, one per level.
 *
 * Cogdell recurses here because its `NavItem` is recursive. Ours deliberately
 * caps at two levels (`NavItem.children: NavChild[]`, `NavChild.children:
 * NavLink[]`), and the desktop bar renders from the same constant — so this
 * normalises locally rather than making the shared types recursive.
 *
 * Panel ids encode the index path (`root`, `root-1`, `root-1-0`), so a drill
 * target is always `${panel.id}-${rowIndex}`.
 */
type Row = {
  label: string;
  href?: string;
  targetId?: string;
};
type Panel = { id: string; title: string; parentId: string | null; rows: Row[] };

const panels: Panel[] = [
  {
    id: "root",
    title: "Menu",
    parentId: null,
    rows: items.map((item, i) => ({
      label: item.label,
      href: item.href,
      targetId: item.children ? `root-${i}` : undefined,
    })),
  },
];

items.forEach((item, i) => {
  if (!item.children) return;
  const id = `root-${i}`;

  // No "overview" row: the parent row that opened this panel is itself a link,
  // so the section's own page is always one tap away in the level above.
  // (`item.footerLink` is still used by the desktop dropdown.)
  const rows: Row[] = item.children.map((child, j) => ({
    label: child.label,
    href: child.href,
    targetId: child.children ? `${id}-${j}` : undefined,
  }));

  panels.push({ id, title: item.label, parentId: "root", rows });

  item.children.forEach((child, j) => {
    if (!child.children) return;
    const childRows: Row[] = child.children.map((leaf) => ({
      label: leaf.label,
      href: leaf.href,
    }));
    panels.push({ id: `${id}-${j}`, title: child.label, parentId: id, rows: childRows });
  });
});
---

<div class="mobile-nav" id="mobile-nav">
  <div class="mobile-nav__scrim" data-scrim></div>

  <aside
    class="drawer on-dark"
    id="mobile-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Site menu"
    aria-hidden="true"
    inert
  >
    <div class="drawer__bar">
      <button class="drawer__icon" type="button" data-back hidden aria-label="Back">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
      </button>
      <span class="drawer__title" data-title>Menu</span>
      <button class="drawer__icon" type="button" data-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>

    <div class="drawer__body">
      {
        panels.map((panel) => (
          <ul
            class:list={["drawer__panel", { "is-open": panel.id === "root" }]}
            data-panel-id={panel.id}
            data-title={panel.title}
            role="list"
          >
            {panel.rows.map((row, i) => (
              <li class="drawer__row">
                {row.href ? (
                  <a
                    href={row.href}
                    class="drawer__link"
                    aria-current={isWithin(pathname, row.href) ? "page" : undefined}
                  >
                    {row.label}
                  </a>
                ) : (
                  /* A category with no page of its own — the whole row drills. */
                  <button class="drawer__link drawer__link--drill" type="button" data-target={row.targetId}>
                    {row.label}
                    <svg class="drawer__chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
                  </button>
                )}

                {row.href && row.targetId && (
                  <button
                    class="drawer__expand"
                    type="button"
                    data-target={row.targetId}
                    aria-label={`Open ${row.label} submenu`}
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
                  </button>
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </div>

    <div class="drawer__foot">
      <Image src={logoWhite} alt={FIRM.name} width={148} height={32} densities={[1, 2]} loading="lazy" />
      <span class="drawer__foot-label">Reach us 24/7</span>
      <a href={FIRM.phone.href} class="drawer__phone">{FIRM.phone.display}</a>
      <a href="/contact/" class="btn btn--gold btn--block">Free Consultation</a>
    </div>
  </aside>
</div>

<style>
  /* Only exists below the bar's breakpoint; the toggle lives in Nav.astro. */
  @media (min-width: 1280px) {
    .mobile-nav {
      display: none;
    }
  }

  /* ---- Scrim ------------------------------------------------------------- */

  .mobile-nav__scrim {
    position: fixed;
    inset: 0;
    background: rgba(28, 34, 21, 0.55);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration) var(--ease),
      visibility var(--duration) var(--ease);
    z-index: var(--z-overlay);
  }

  .mobile-nav.is-open .mobile-nav__scrim {
    opacity: 1;
    visibility: visible;
  }

  /* ---- Drawer ------------------------------------------------------------ */

  .drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    width: min(380px, 88vw);
    display: flex;
    flex-direction: column;
    background: var(--forest-800);
    border-inline-start: 3px solid var(--gold);
    transform: translateX(100%);
    /* Deliberately NOT `visibility: hidden` when closed. A hidden element
       cannot take focus, and the visibility transition only resolves on an
       animation frame — so focusing the close button on open was a silent
       no-op that stranded focus outside the dialog. `inert` (toggled in the
       script) is what makes the closed drawer non-interactive; the shadow is
       faded instead of hidden so it does not bleed over the page. */
    box-shadow: -18px 0 50px rgba(0, 0, 0, 0);
    transition: transform var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
    z-index: var(--z-modal);
  }

  .mobile-nav.is-open .drawer {
    transform: translateX(0);
    box-shadow: -18px 0 50px rgba(0, 0, 0, 0.45);
  }

  /* Full-bleed on phones. 480px is the documented `sm` step. */
  @media (max-width: 480px) {
    .drawer {
      width: 100vw;
      border-inline-start: none;
      border-block-start: 3px solid var(--gold);
    }
  }

  /* ---- Bar: back / title / close ----------------------------------------- */

  .drawer__bar {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-16) var(--space-20);
    border-block-end: 1px solid var(--on-dark-rule);
    min-height: 72px;
  }

  .drawer__title {
    flex: 1;
    font-family: var(--font-label);
    font-size: var(--fs-14);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-eyebrow-wide);
    text-transform: uppercase;
    color: var(--gold);
    line-height: var(--lh-flat);
  }

  .drawer__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--on-dark-border);
    border-radius: var(--radius-sm);
    color: var(--on-dark);
    transition: color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .drawer__icon:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .drawer__icon[hidden] {
    display: none;
  }

  /* ---- Panels ------------------------------------------------------------ */

  .drawer__body {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .drawer__panel {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    /* Same fill as the drawer, so a panel sliding over its parent is seamless. */
    background: var(--forest-800);
    transform: translateX(100%);
    transition: transform var(--duration) var(--ease);
  }

  .drawer__panel.is-open {
    transform: translateX(0);
  }

  .drawer__row {
    display: flex;
    align-items: stretch;
    border-block-end: 1px solid var(--on-dark-rule);
  }

  .drawer__link {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    width: 100%;
    padding: var(--space-16) var(--space-20);
    font-family: var(--font-label);
    font-size: var(--fs-16);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-nav);
    text-transform: uppercase;
    text-align: start;
    color: var(--on-dark);
    transition: background var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .drawer__link:hover,
  .drawer__link[aria-current="page"] {
    background: var(--gold-wash);
    color: var(--gold);
  }

  .drawer__chevron {
    flex: none;
    color: var(--gold);
  }

  /* Drill affordance for a row that is ALSO a link — divided from it so the
     two tap targets are unambiguous. */
  .drawer__expand {
    display: inline-flex;
    align-items: center;
    flex: none;
    padding-inline: var(--space-20);
    border-inline-start: 1px solid var(--on-dark-rule);
    color: var(--gold);
    transition: background var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .drawer__expand:hover {
    background: var(--gold-wash);
    color: var(--on-dark);
  }

  /* ---- Foot -------------------------------------------------------------- */

  .drawer__foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-24) var(--space-20);
    background: var(--forest-1000);
  }

  .drawer__foot :global(img) {
    height: 32px;
    width: auto;
    margin-block-end: var(--space-20);
  }

  .drawer__foot-label {
    font-family: var(--font-label);
    font-size: var(--fs-12);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--on-dark-50);
  }

  .drawer__phone {
    display: block;
    margin-block-end: var(--space-16);
    font-family: var(--font-display);
    font-size: var(--fs-30);
    font-weight: var(--fw-semibold);
    line-height: 1.15;
    color: var(--on-dark);
    transition: color var(--duration) var(--ease);
  }

  .drawer__phone:hover {
    color: var(--gold);
  }
</style>

<script>
  const root = document.getElementById("mobile-nav");
  const drawer = document.getElementById("mobile-drawer");
  const toggle = document.getElementById("nav-toggle");

  if (root && drawer && toggle) {
    const scrim = root.querySelector<HTMLElement>("[data-scrim]")!;
    const backBtn = root.querySelector<HTMLButtonElement>("[data-back]")!;
    const closeBtn = root.querySelector<HTMLButtonElement>("[data-close]")!;
    const titleEl = root.querySelector<HTMLElement>("[data-title]")!;

    // Drill-down state: a stack of open panel ids. `root` is always the base.
    const stack: string[] = ["root"];
    const panelById = (id: string) =>
      root.querySelector<HTMLElement>(`[data-panel-id="${id}"]`);

    const updateBar = () => {
      const panel = panelById(stack[stack.length - 1]);
      titleEl.textContent = panel?.dataset.title ?? "Menu";
      backBtn.hidden = stack.length <= 1;
    };

    const drill = (id: string) => {
      const panel = panelById(id);
      if (!panel) return;
      panel.classList.add("is-open");
      stack.push(id);
      updateBar();
      panel.scrollTop = 0;
    };

    const back = () => {
      if (stack.length <= 1) return;
      panelById(stack.pop()!)?.classList.remove("is-open");
      updateBar();
    };

    const resetPanels = () => {
      while (stack.length > 1) {
        panelById(stack.pop()!)?.classList.remove("is-open");
      }
      updateBar();
    };

    const isOpen = () => root.classList.contains("is-open");

    const setOpen = (open: boolean) => {
      root.classList.toggle("is-open", open);
      document.body.classList.toggle("drawer-open", open);
      drawer.setAttribute("aria-hidden", String(!open));
      drawer.toggleAttribute("inert", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");

      // Contain focus by making the rest of the page inert, rather than
      // hand-rolling a Tab trap. Must be lifted BEFORE returning focus to the
      // toggle, or the focus call lands on an inert element and is a no-op.
      for (const el of Array.from(document.body.children)) {
        if (el !== root) el.toggleAttribute("inert", open);
      }

      // Safe to focus synchronously: the drawer is never `visibility: hidden`,
      // only translated off-screen and `inert`. Both were lifted above.
      if (open) closeBtn.focus();
      else toggle.focus();
    };

    // Reset the drill state only once the drawer has finished sliding away, so
    // the panels never visibly snap back mid-animation.
    let resetTimer: number | undefined;
    drawer.addEventListener("transitionend", (event) => {
      if (event.propertyName === "transform" && !isOpen()) resetPanels();
    });

    toggle.addEventListener("click", () => {
      const open = !isOpen();
      setOpen(open);
      if (!open) {
        // Fallback in case transitionend never fires (reduced motion, etc.).
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(resetPanels, 600);
      }
    });

    const close = () => {
      setOpen(false);
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(resetPanels, 600);
    };

    closeBtn.addEventListener("click", close);
    scrim.addEventListener("click", close);
    backBtn.addEventListener("click", back);

    for (const btn of root.querySelectorAll<HTMLElement>("[data-target]")) {
      btn.addEventListener("click", () => drill(btn.dataset.target!));
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) close();
    });

    // Leaving the breakpoint with the drawer open must force it closed.
    // Otherwise the page is stranded inert AND scroll-locked, with the toggle
    // hidden — nothing on screen can recover it. That failure mode is bad
    // enough to justify guarding it twice: `change` is the precise signal, and
    // `resize` is the belt-and-braces one for engines that miss it.
    //
    // The MediaQueryList is held in a variable deliberately: an unreferenced
    // one can be garbage-collected and take its listener with it.
    const wide = window.matchMedia("(min-width: 1280px)");
    const closeIfDesktop = () => {
      if (wide.matches && isOpen()) close();
    };
    wide.addEventListener("change", closeIfDesktop);
    window.addEventListener("resize", closeIfDesktop);
  }
</script>
