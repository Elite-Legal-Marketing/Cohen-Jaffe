---
/**
 * Homepage "Practice areas" section — "What happened?"
 *
 * Design: the PRACTICE AREAS band of `Cohen & Jaffe Homepage v1.dc.html`
 * (lines 327–401). A centred header on the sand surface, then a 520px rail
 * of seven tabs beside a white detail pane — photograph, kicker, thesis,
 * legal callout, a partner's line, three sub-links and a ghost button — and
 * under it the disclaimer and the "Handling all areas" card of twelve links.
 *
 * Content is hardcoded for now — `src/data/homePracticeAreas.ts` carries the
 * copy AND the provenance of every clause, which for a section stating New
 * York law is the part that matters. AGENTS.md → "Building sections": build
 * it, approve it, then model it in Sanity. The practice areas themselves are
 * already Sanity documents; the constant mirrors what the query will
 * dereference.
 *
 * Three things here are ours rather than the artboard's:
 *
 *   - THE TABS ARE RADIO BUTTONS, and there is no JavaScript. The artboard
 *     switches panes with the canvas's own click state. Here each tab is an
 *     `<input type="radio">` (visually hidden), its `<label>`, and its pane,
 *     in that order, so `:checked + label + pane` reveals the pane with CSS
 *     adjacency alone. Every pane is in the DOM for crawlers, the first is
 *     active with no script, and the radio group gives arrow-key selection
 *     and one tab stop for free. Adjacency rather than `:has()` because it
 *     works for any number of tabs, not the seven the selectors were written
 *     for. Same reasoning as the `<details>` rows in "Our goals".
 *
 *   - BELOW 1024px IT IS AN ACCORDION, not a horizontal tab strip. Because
 *     the DOM already interleaves each tab with its own pane, collapsing the
 *     grid to one column puts every open pane directly under its tab — the
 *     tapped thing stays in view — and it costs a media query, not a second
 *     layout. Decided with the user; see HANDOFF.
 *
 *   - THE GHOST BUTTON IS LOCAL. `.btn--outline` is ink-on-cream with an ink
 *     hover fill; the artboard's is a gold hairline with gold text that fills
 *     gold on hover, set in Roboto Condensed at 54px. It gets a global variant
 *     only when the listing page becomes a second consumer.
 *
 * The icons are the vendor set converted to `currentColor`, so olive→gold on
 * a tab is one `color` transition — see `PracticeAreaIcon.astro`.
 */
import PracticeAreaIcon from "./PracticeAreaIcon.astro";
import Check from "../assets/icons/practice-areas/check.svg";
import { urlFor, srcSet } from "../lib/image";
import { practiceAreaHref } from "../lib/practiceAreas";
import { HOME_PRACTICE_AREAS } from "../data/homePracticeAreas";

const section = HOME_PRACTICE_AREAS;
const tabs = section.tabs ?? [];
const allAreas = section.allAreas ?? [];

/**
 * The pane's photo well is ~450px wide at the artboard width and a full-width
 * strip on a phone, so these cover the ramp at 1x and 2x.
 */
const PHOTO_WIDTHS = [480, 800, 1200];

/** The hotspot, when an editor has set one, becomes `object-position`. */
const focus = (hotspot: { x: number; y: number } | null | undefined) =>
  hotspot ? `${Math.round(hotspot.x * 100)}% ${Math.round(hotspot.y * 100)}%` : "50% 40%";
---

<section class="pa section" aria-labelledby="pa-heading">
  <div class="container">
    <header class="pa__head">
      <p class="eyebrow eyebrow--center">{section.eyebrow}</p>
      <h2 class="pa__heading" id="pa-heading">{section.heading}</h2>
      {section.subheading && <p class="eyebrow eyebrow--bare pa__sub">{section.subheading}</p>}
    </header>

    <div class="pa__tabs" role="radiogroup" aria-label="Practice area" style={`--tabs: ${tabs.length}`}>
      {
        tabs.map((tab, i) => {
          const area = tab.area;
          const id = `pa-${tab._key}`;
          const image = area.image?.asset ? area.image : null;
          return (
            <>
              <input type="radio" name="pa" id={id} class="pa__radio" checked={i === 0} />
              <label for={id} class="pa__tab">
                {/* A wrapper this template owns: a class passed INTO the icon
                    component would never match the scoped rules below. */}
                {area.icon && (
                  <span class="pa__icon" aria-hidden="true">
                    <PracticeAreaIcon name={area.icon} />
                  </span>
                )}
                <span class="pa__tab-name">{area.name}</span>
                <span class="arrow pa__tab-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </label>

              <article class:list={["pa__pane", { "pa__pane--no-photo": !image }]} aria-labelledby={`${id}-kicker`}>
                {image && (
                  <div class="pa__photo">
                    <img
                      src={urlFor(image).width(800).url()}
                      srcset={srcSet(image, PHOTO_WIDTHS)}
                      sizes="(max-width: 768px) 92vw, (max-width: 1024px) 40vw, 26vw"
                      alt={image.alt ?? ""}
                      width="800"
                      height="533"
                      style={`object-position: ${focus(image.hotspot)}`}
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  </div>
                )}

                <div class="pa__copy">
                  <p class="eyebrow eyebrow--bare pa__kicker" id={`${id}-kicker`}>
                    {area.name}
                  </p>
                  <h3 class="pa__headline">{tab.headline}</h3>

                  {tab.callout && (
                    <div class="pa__callout">
                      <p>{tab.callout}</p>
                    </div>
                  )}

                  {tab.links.length > 0 && (
                    <ul class="pa__links" role="list">
                      {tab.links.map((link) => (
                        <li>
                          <a class="pa__link" href={link.href}>
                            {link.label}
                            <span class="arrow" aria-hidden="true">
                              &rarr;
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}

                  <a class="pa__cta" href={practiceAreaHref(area.slug)}>
                    {area.linkLabel ?? area.name}
                    <span class="arrow" aria-hidden="true">
                      &rarr;
                    </span>
                  </a>
                </div>
              </article>
            </>
          );
        })
      }
    </div>

    {section.disclaimer && <p class="pa__disclaimer">{section.disclaimer}</p>}

    {
      allAreas.length > 0 && (
        <div class="pa__all">
          <div class="pa__all-head">
            <h3 class="pa__all-heading">{section.allHeading}</h3>
            {section.allLink?.href && (
              <a class="pa__all-link" href={section.allLink.href}>
                {section.allLink.label}
                <span class="arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            )}
          </div>
          <ul class="pa__all-grid" role="list">
            {allAreas.map((item) => (
              <li>
                <a class="pa__all-item" href={practiceAreaHref(item.slug)}>
                  <span class="pa__check" aria-hidden="true">
                    <Check width="24" height="24" focusable="false" />
                  </span>
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
          {section.allLink?.href && (
            <a class="pa__all-link pa__all-link--foot" href={section.allLink.href}>
              {section.allLink.label}
              <span class="arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .pa {
    background-color: var(--sand);
    border-block-end: 1px solid var(--border);
  }

  /* --- Header ------------------------------------------------------------ */

  .pa__head {
    text-align: center;
    margin-block-end: var(--space-md);
  }

  .pa__heading {
    font-family: var(--font-heading);
    font-size: var(--fs-52);
    font-weight: var(--fw-regular);
    line-height: 1.06;
    letter-spacing: var(--ls-display);
    color: var(--color-heading);
    margin-block-end: var(--space-14);
  }

  /* The line under the heading: same family as the kicker, one step quieter —
     0.14em rather than 0.16em, semibold, and the meta grey. */
  .pa__sub {
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    color: var(--faint);
    margin-block-end: 0;
  }

  /* --- Tabs + pane ------------------------------------------------------- */

  /* Labels fill column one, one per FIXED 96px row; the open pane spans every
     row of column two and takes its own content's height. The tabs never grow
     or shrink with the pane — the client's call — so the pane cannot be
     allowed to size the rows: the trailing `auto` row is where a pane taller
     than the rail puts its excess, and a shorter pane simply ends early
     (`align-self: start`). Its only cost is one row-gap under the rail when
     the extra row is empty. */
  .pa__tabs {
    display: grid;
    grid-template-columns: minmax(0, 520px) minmax(0, 1fr);
    grid-template-rows: repeat(var(--tabs), 96px) auto;
    gap: var(--space-12) var(--space-28);
    margin-block-end: var(--space-26);
  }

  /* Out of the grid's flow and off the page, but NOT `display: none` — a
     hidden radio cannot take focus, and the keyboard model depends on it.
     `.visually-hidden` is not used because its `:not(:focus)` clause is for
     skip links and would pop the radio back into view when focused. */
  .pa__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .pa__tab {
    grid-column: 1;
    display: flex;
    align-items: center;
    gap: var(--space-16);
    height: 96px;
    padding: var(--space-12) var(--space-26);
    background-color: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-label);
    font-size: var(--fs-24);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .pa__tab:hover {
    border-color: var(--gold-ink);
    color: var(--gold-ink);
  }

  /* The icon is olive on a white tab and gold on the forest one. It inherits
     nothing from the label's colour on purpose: the label goes gold on hover
     and the icon should not. */
  .pa__icon {
    flex: none;
    display: block;
    width: 40px;
    height: 40px;
    color: var(--green);
    transition: color var(--duration) var(--ease);
  }

  /* The SVG is rendered by the icon component, so it is reached with
     `:global` and sized by its wrapper. */
  .pa__icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pa__tab-name {
    flex: 1;
    min-width: 0;
  }

  /* Only the active tab shows its arrow. It is faded, not removed, so it
     can cross-fade with the fill. The global `.arrow` slide is keyed on
     `a:hover` / `button:hover`, which a label is neither — so it is restated. */
  .pa__tab-arrow {
    flex: none;
    font-size: var(--fs-21);
    opacity: 0;
    transition:
      opacity var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .pa__tab:hover .pa__tab-arrow {
    transform: translate(0.25em, var(--arrow-shift));
  }

  .pa__radio:checked + .pa__tab {
    background-color: var(--green);
    border-color: var(--green);
    color: var(--cream);
  }

  .pa__radio:checked + .pa__tab .pa__icon {
    color: var(--gold);
  }

  .pa__radio:checked + .pa__tab .pa__tab-arrow {
    opacity: 1;
  }

  .pa__radio:focus-visible + .pa__tab {
    outline: 2px solid var(--gold-ink);
    outline-offset: 2px;
  }

  /* Hidden until its radio is checked. `display`, not `visibility`: a hidden
     pane must take no space in the grid. */
  .pa__pane {
    display: none;
    grid-column: 2;
    grid-row: 1 / -1;
    align-self: start;
    grid-template-columns: minmax(280px, 40%) minmax(0, 1fr);
    gap: var(--space-44);
    padding: var(--space-44) var(--space-44);
    background-color: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .pa__radio:checked + .pa__tab + .pa__pane {
    display: grid;
  }

  .pa__pane--no-photo {
    grid-template-columns: minmax(0, 1fr);
  }

  /* --- Pane: photograph -------------------------------------------------- */

  .pa__photo {
    position: relative;
    min-height: 420px;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .pa__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* object-position is per-photograph and set inline from the hotspot. */
  }

  /* --- Pane: copy -------------------------------------------------------- */

  .pa__copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pa__kicker {
    font-size: var(--fs-14);
    letter-spacing: 0.18em;
    margin-block-end: var(--space-14);
  }

  .pa__headline {
    font-family: var(--font-heading);
    font-size: var(--fs-36);
    font-weight: var(--fw-regular);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    color: var(--color-heading);
    text-wrap: balance;
    margin-block-end: var(--space-22);
  }

  .pa__callout {
    padding: var(--space-20) var(--space-24);
    background-color: var(--cream);
    border-inline-start: 5px solid var(--gold);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: var(--fs-16);
    line-height: var(--lh-body);
    color: var(--body);
    margin-block-end: var(--space-24);
  }


  .pa__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-block-end: var(--space-22);
    border-block-end: 1px solid var(--border);
    margin-block-end: var(--space-24);
  }

  /* Underline declared at rest and faded in, because `text-decoration-line`
     cannot be transitioned — see AGENTS.md. */
  .pa__link {
    font-size: var(--fs-16);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-body);
    color: var(--body);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: transparent;
    transition:
      color var(--duration) var(--ease),
      text-decoration-color var(--duration) var(--ease);
  }

  .pa__link:hover,
  .pa__link:focus-visible {
    color: var(--gold-ink);
    text-decoration-color: var(--gold-ink);
  }

  /* Pinned to the bottom of the stretched column, so the button sits level
     with the photograph's foot whatever the copy above it does. */
  .pa__cta {
    align-self: flex-start;
    margin-block-start: auto;
    display: inline-flex;
    align-items: center;
    min-height: 54px;
    padding: var(--space-14) var(--space-30);
    border: 1px solid var(--gold);
    border-radius: var(--radius-sm);
    background-color: transparent;
    font-family: var(--font-label);
    font-size: var(--fs-15);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    line-height: var(--lh-label);
    color: var(--gold-ink);
    text-decoration: none;
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .pa__cta:hover,
  .pa__cta:focus-visible {
    background-color: var(--gold);
    color: var(--ink);
  }

  /* --- Disclaimer + "all areas" ------------------------------------------ */

  .pa__disclaimer {
    max-width: 1000px;
    font-size: var(--fs-15);
    line-height: var(--lh-small);
    color: var(--faint);
    margin-block-end: var(--space-26);
  }

  .pa__all {
    padding: var(--space-44) var(--space-44);
    background-color: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .pa__all-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-40);
    padding-block-end: var(--space-22);
    border-block-end: 1px solid var(--border);
    margin-block-end: var(--space-26);
  }

  .pa__all-heading {
    font-family: var(--font-heading);
    font-size: var(--fs-30);
    font-weight: var(--fw-regular);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    color: var(--color-heading);
    margin-block-end: 0;
  }

  .pa__all-link {
    font-family: var(--font-label);
    font-size: var(--fs-15);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    line-height: var(--lh-label);
    color: var(--green);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    text-decoration-color: transparent;
    transition:
      color var(--duration) var(--ease),
      text-decoration-color var(--duration) var(--ease);
  }

  .pa__all-link:hover,
  .pa__all-link:focus-visible {
    color: var(--gold-ink);
    text-decoration-color: var(--gold-ink);
  }

  /* The same link rendered a second time under the grid, for phones only —
     see the 768px block. Desktop never shows both. */
  .pa__all-link--foot {
    display: none;
  }

  .pa__all-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-18) var(--space-40);
  }

  .pa__all-item {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    font-size: var(--fs-17);
    line-height: var(--lh-card);
    color: var(--body);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .pa__all-item:hover,
  .pa__all-item:focus-visible {
    color: var(--gold-ink);
  }

  .pa__check {
    flex: none;
    display: block;
    width: 24px;
    height: 24px;
    color: var(--gold);
  }

  .pa__check :global(svg) {
    display: block;
  }

  /* --- Responsive ---------------------------------------------------------
     Not from the designs — the artboard is a fixed 1660px board. These blocks
     MUST stay after the base rules they override; equal specificity means
     source order decides. */

  /* Pane and card give back some padding before the layout changes. */
  @media (max-width: 1400px) {
    .pa__pane {
      gap: var(--space-32);
      padding: var(--space-32) var(--space-36);
    }

    .pa__tabs {
      grid-template-columns: minmax(0, 440px) minmax(0, 1fr);
    }
  }

  /* lg and below — the ACCORDION. One column: each open pane sits directly
     under its own tab, because the DOM already interleaves them. */
  @media (max-width: 1024px) {
    .pa__tabs {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }

    .pa__pane {
      grid-column: 1;
      grid-row: auto;
    }

    /* Stacked, the arrow points at nothing — the pane is below, not beside. */
    .pa__tab-arrow {
      display: none;
    }

    .pa__all-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pa__all {
      padding: var(--space-32) var(--space-32);
    }
  }

  /* md and below — the pane stacks: photograph above the copy, as a strip. */
  @media (max-width: 768px) {
    .pa__pane {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
      padding: var(--space-24);
    }

    .pa__photo {
      min-height: 0;
      height: 240px;
    }

    .pa__tab {
      height: 80px;
      padding: var(--space-10) var(--space-20);
      gap: var(--space-14);
    }

    .pa__icon {
      width: 32px;
      height: 32px;
    }

    /* The link moves from the head row to under the list: on a phone the
       twelve links are a tall column and "see all" belongs at the end of it. */
    .pa__all-head .pa__all-link {
      display: none;
    }

    .pa__all-link--foot {
      display: inline-flex;
      margin-block-start: var(--space-24);
      padding-block-start: var(--space-22);
      border-block-start: 1px solid var(--border);
      width: 100%;
    }
  }

  /* sm and below — phones. */
  @media (max-width: 500px) {
    .pa__all-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-14);
    }

    .pa__all {
      padding: var(--space-24) var(--space-20);
    }

    .pa__pane {
      padding: var(--space-20) var(--space-16);
    }

    .pa__cta {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pa__tab:hover .pa__tab-arrow {
      transform: translateY(var(--arrow-shift));
    }
  }
</style>
