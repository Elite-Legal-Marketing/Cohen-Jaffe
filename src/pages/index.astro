---
import { sanityClient } from "sanity:client";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import CaseResults from "../components/CaseResults.astro";
import About from "../components/About.astro";
import Fees from "../components/Fees.astro";
import PracticeAreas from "../components/PracticeAreas.astro";
import { HOME_PAGE_QUERY } from "../lib/queries";
import type { HOME_PAGE_QUERY_RESULT } from "../sanity/sanity.types";

const home = await sanityClient.fetch<HOME_PAGE_QUERY_RESULT>(HOME_PAGE_QUERY);
---

<Layout
  title="Cohen & Jaffe"
  description="Long Island personal injury lawyers. For more than 100 years combined, we have fought for injury victims and their families. Free consultation, and you pay nothing unless we win."
  videoEmbed
>
  {home?.hero && <Hero hero={home.hero} />}
  {home?.stats && home.stats.length > 0 && <Stats stats={home.stats} />}
  {home?.caseResults && <CaseResults section={home.caseResults} />}
  {home?.about && <About section={home.about} />}
  {home?.fees && <Fees section={home.fees} />}
  <PracticeAreas />
</Layout>
