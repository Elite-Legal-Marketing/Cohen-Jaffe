---
import { sanityClient } from "sanity:client";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import CaseResults from "../components/CaseResults.astro";
import About from "../components/About.astro";
import Fees from "../components/Fees.astro";
import PracticeAreas from "../components/PracticeAreas.astro";
import Deadlines from "../components/Deadlines.astro";
import Reviews from "../components/Reviews.astro";
import Attorneys from "../components/Attorneys.astro";
import { HOME_PAGE_QUERY, HOME_ATTORNEYS_QUERY } from "../lib/queries";
import { HOME_ATTORNEYS } from "../data/homeAttorneys";
import type {
  HOME_PAGE_QUERY_RESULT,
  HOME_ATTORNEYS_QUERY_RESULT,
} from "../sanity/sanity.types";

const home = await sanityClient.fetch<HOME_PAGE_QUERY_RESULT>(HOME_PAGE_QUERY);

/**
 * ⚠️ TEMPORARY — the attorneys band is at the hardcoded stage, so its copy and
 * running order come from `src/data/homeAttorneys.ts` and the six documents are
 * fetched separately. Both go away when the section is modelled: an
 * `attorneys[]->` projection on `HOME_PAGE_QUERY` replaces the whole block.
 *
 * GROQ's `in` returns matches in the dataset's own order, not the order of the
 * array it was given, so the running order is restored here by index. An
 * unresolved slug simply drops out.
 */
const attorneyBySlug = new Map(
  (await sanityClient.fetch<HOME_ATTORNEYS_QUERY_RESULT>(HOME_ATTORNEYS_QUERY, {
    slugs: [...HOME_ATTORNEYS.order],
  })).map((attorney) => [attorney.slug, attorney]),
);

const attorneys = HOME_ATTORNEYS.order.flatMap((slug) => attorneyBySlug.get(slug) ?? []);
---

<Layout
  title="Cohen & Jaffe"
  description="Long Island personal injury lawyers. For more than 100 years combined, we have fought for injury victims and their families. Free consultation, and you pay nothing unless we win."
  videoEmbed
>
  {home?.hero && <Hero hero={home.hero} />}
  {home?.stats && home.stats.length > 0 && <Stats stats={home.stats} />}
  {home?.caseResults && <CaseResults section={home.caseResults} />}
  {home?.about && <About section={home.about} />}
  {home?.fees && <Fees section={home.fees} />}
  {home?.practiceAreas && <PracticeAreas section={home.practiceAreas} />}
  {home?.deadlines && <Deadlines section={home.deadlines} />}
  {home?.reviews && <Reviews section={home.reviews} />}
  {
    attorneys.length > 0 && (
      <Attorneys
        section={{
          eyebrow: HOME_ATTORNEYS.eyebrow,
          heading: HOME_ATTORNEYS.heading,
          attorneys,
          cta: HOME_ATTORNEYS.cta,
        }}
      />
    )
  }
</Layout>
