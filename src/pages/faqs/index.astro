---
/**
 * The FAQs hub — every question as a card, filterable by category.
 *
 * From `CJ - FAQ.dc.html`. Already in the nav at Resources → FAQ
 * (`src/data/navigation.ts:202`), where the link was dead until this page.
 *
 * ⚠️ THIS IS A LIST OF LINKS, NOT A PAGE OF ANSWERS, and that decision is what
 * the whole FAQ shape turns on. Rendering all 180 answers inline was measured at
 * **895 KB uncompressed / 179 KB brotli / ~9,200 element nodes** — 3.3x the
 * homepage, on a page with no images at all. Every answer has its own page at
 * its own indexed URL, so this page's job is to get you to one.
 *
 * ── THE FILTER WORKS WITHOUT JAVASCRIPT, AND THAT IS DELIBERATE ─────────────
 *
 * There are two mechanisms here and they compose rather than compete:
 *
 *   1. CSS-ONLY FILTERING — nineteen visually-hidden radios, then the pill row,
 *      then the grid, all siblings of one parent, so a `~` rule can hide the
 *      cards that do not match. Generated from `FAQ_CATEGORIES` below. This is
 *      the whole filter when scripting is off.
 *   2. THE SCRIPT adds the sixteen-at-a-time cap, the "View more" button and the
 *      entry animation, none of which CSS can do on its own.
 *
 * ⚠️ THE CAP LIVES BEHIND `data-paged`, WHICH ONLY THE SCRIPT SETS. Put the cap
 * in plain CSS and a visitor without JavaScript sees sixteen cards with no way
 * to reach the other 164 — and a crawler follows sixteen links instead of 180.
 * With no script every matching card is simply shown.
 *
 * ⚠️ THE GENERAL SIBLING COMBINATOR is what makes the CSS-only half possible.
 * `PracticeAreas.astro` gets away with `:checked + label + pane` because each of
 * its tabs reveals ONE adjacent pane; a filter has to hide items scattered
 * through a single list, which adjacency cannot reach.
 *
 * ── WHAT IS DEFERRED FROM THE BOARD ────────────────────────────────────────
 *
 *   - The breadcrumb bar. Removed on the client's instruction (2026-09-08):
 *     NO BREADCRUMBS ANYWHERE ON THIS SITE.
 *   - The four "top question" cards — invented artboard copy with no source, and
 *     a fifth piece of hand-written content nobody asked for. Their card shape
 *     is reused for the questions themselves instead.
 *   - The sidebar, and the "Prefer to watch?" and "Related" cards in it: the
 *     page is one container now, on the client's instruction (2026-09-08).
 */
import { sanityClient } from "sanity:client";
import Layout from "../../layouts/Layout.astro";
import Stats from "../../components/Stats.astro";
import QuoteBand from "../../components/QuoteBand.astro";
import ContactForm from "../../components/ContactForm.astro";
import { FAQ_INDEX_QUERY, FAQS_PAGE_QUERY } from "../../lib/queries";
import { faqHref } from "../../lib/faqs";
import { FAQ_CATEGORIES, faqCategoryTitle } from "../../sanity/schemaTypes/faqCategories";
import type {
  FAQ_INDEX_QUERY_RESULT,
  FAQS_PAGE_QUERY_RESULT,
} from "../../sanity/sanity.types";

/**
 * Two fetches, because they are two different things: the page's own chrome, and
 * every question in the collection. Folding them into one would mean pulling 180
 * documents to read four strings off a singleton.
 */
const [page, faqs] = await Promise.all([
  sanityClient.fetch<FAQS_PAGE_QUERY_RESULT>(FAQS_PAGE_QUERY),
  sanityClient.fetch<FAQ_INDEX_QUERY_RESULT>(FAQ_INDEX_QUERY).then((rows) => rows ?? []),
]);

/** How many cards show before "View more" — four full rows of the 4-across grid. */
const BATCH = 16;

/**
 * Only the categories that actually hold a question. A pill that filters to an
 * empty grid is a dead control, and six of the eighteen terms are thin enough
 * that one editorial decision could empty them.
 *
 * ⚠️ ALPHABETICAL, NOT BY COUNT, on the client's instruction (2026-09-08).
 * `FAQ_CATEGORIES` is already alphabetical, so this preserves it — sorting by
 * count would put Car Accidents first and reshuffle the rail every time the
 * collection changed, which is the opposite of what a navigation row wants.
 */
const counts = new Map<string, number>();
for (const faq of faqs) {
  if (faq.category) counts.set(faq.category, (counts.get(faq.category) ?? 0) + 1);
}
const categories = FAQ_CATEGORIES.filter(({ value }) => (counts.get(value) ?? 0) > 0);

const id = (value: string) => `fc-${value}`;

/**
 * ⚠️ THE FILTER CSS IS GENERATED FROM THE TAXONOMY, and emitted `is:inline` so
 * Astro does not scope it. Two rules per category — hide the cards that do not
 * match, and light that category's pill. Thirty-six rules hand-maintained would
 * drift from `FAQ_CATEGORIES` the first time a term changed; generated, they
 * cannot.
 *
 * The cost of `is:inline` is that these class names are unscoped, so they are
 * hand-namespaced (`.faq-grid`, `.faq-card`, `.faq-filter`). Everything else on
 * the page stays in the ordinary scoped block below.
 */
const activePill =
  "background: var(--green); border-color: var(--green); color: var(--cream);";

const filterCss = categories
  .map(
    ({ value }) => `
#${id(value)}:checked ~ .faq-grid .faq-card:not([data-cat="${value}"]) { display: none; }
#${id(value)}:checked ~ .faq-filter label[for="${id(value)}"] { ${activePill} }`,
  )
  .join("");

const allCss = `
#fc-all:checked ~ .faq-filter label[for="fc-all"] { ${activePill} }`;
---

<Layout title="Frequently Asked Questions" description={page?.lead ?? undefined}>
  <section class="faq-hero surface-forest-deep">
    <div class="container">
      <div class="faq-hero__copy">
        {page?.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
        <h1 class="faq-hero__title">{page?.heading}</h1>
        {page?.lead && <p class="faq-hero__lead">{page.lead}</p>}
      </div>
    </div>
  </section>

  <section class="faq-index">
    <div class="container faq-index__inner" data-faq-index data-batch={BATCH}>
      {/* ⚠️ NO COUNT HERE. The board sets a "19 questions" line against this
          heading, but every pill already carries its own count and the active
          one is the count for what is on screen — printing it twice meant two
          numbers to keep in step, and they disagreed for a moment on every
          filter change. Removed on the client's instruction (2026-09-08). */}
      <header class="faq-index__head">
        {page?.listEyebrow && <p class="eyebrow">{page.listEyebrow}</p>}
        <h2 class="faq-index__heading">{page?.listHeading}</h2>
      </header>

      {/* The radios come first so `~` reaches both the pills and the grid. */}
      <input class="faq-radio" type="radio" name="faq-cat" id="fc-all" value="all" checked />
      {
        categories.map(({ value }) => (
          <input class="faq-radio" type="radio" name="faq-cat" id={id(value)} value={value} />
        ))
      }

      <div class="faq-filter" role="group" aria-label="Filter questions by topic">
        <label for="fc-all">All questions ({faqs.length})</label>
        {
          categories.map(({ value, title }) => (
            <label for={id(value)}>
              {title} ({counts.get(value)})
            </label>
          ))
        }
      </div>

      <div class="faq-grid">
        {
          faqs.map((faq, i) => (
            <a
              class="faq-card"
              href={faqHref(faq.slug!)}
              data-cat={faq.category}
              style={`--i:${i % BATCH}`}
            >
              <span class="faq-card__cat">{faqCategoryTitle(faq.category)}</span>
              <span class="faq-card__q">{faq.question}</span>
              {/* A SPAN, not an anchor. The whole card is the link — nesting one
                  anchor inside another is invalid, and the inner one takes the
                  click. */}
              <span class="faq-card__more">
                View the answer
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </span>
            </a>
          ))
        }
      </div>

      {/* Hidden until the script decides there is more to show — see the note on
          `data-paged` above. Without JavaScript every card is already visible. */}
      <div class="faq-more" hidden data-faq-more>
        <button class="btn btn--ghost btn--wide" type="button">View more</button>
      </div>
    </div>
  </section>

  {page?.stats && page.stats.length > 0 && <Stats stats={page.stats} />}
  {page?.quote && <QuoteBand quote={page.quote} />}
  <ContactForm />
</Layout>

<style is:inline set:html={allCss + filterCss}></style>

<style>
  .faq-hero {
    display: flex;
    align-items: center;
    min-height: 420px;
    padding-block: var(--space-xl);
  }

  /* The 420px floor and the full `--space-xl` are drawn for a 1660px board where
     the heading sits on one line. Below tablet it wraps to two or three, so the
     floor stops doing anything and the padding is stacked on top of copy that is
     already tall — the hero ate most of the first screen before a question was
     visible. */
  @media (max-width: 1023px) {
    .faq-hero {
      min-height: 0;
      /* ⚠️ HALF AGAIN ON THE STEP BELOW. Dropping straight to `--space-lg` /
         `--space-md` was right in direction and overshot: with the 420px floor
         gone, the step alone left the band sitting tight against the copy.
         `* 1.5` is the measured middle — 71px at tablet, 42px on a phone —
         rather than the next name up the scale, which is only about +25% and
         lands short again.

         ⚠️ THIS IS LARGER THAN THE DESKTOP PADDING AND THAT IS CORRECT. At
         1023px this resolves to 75px against `--space-xl`'s 62px at 1024 — the
         padding gets SMALLER as the screen grows, which is normally the ramp
         inversion this repo warns about. It is not visible here because
         `min-height: 420px` takes over at 1024, so the band still grows across
         the boundary: 312px to 420px. Capping it to `--space-xl` would undo the
         increase entirely, since the cap binds at every tablet width. If the
         420px floor is ever removed, this needs revisiting. */
      padding-block: calc(var(--space-lg) * 1.5);
    }
  }

  @media (max-width: 639px) {
    .faq-hero {
      padding-block: calc(var(--space-md) * 1.5);
    }
  }

  .faq-hero__copy {
    max-width: 1000px;
  }

  .faq-hero__title {
    font-family: var(--font-heading);
    font-weight: var(--fw-regular);
    font-size: var(--fs-page-title);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    color: var(--on-dark);
    text-wrap: balance;
    margin-block-end: var(--space-22);
  }

  .faq-hero__lead {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--on-dark-80);
    max-width: var(--container-prose);
    text-wrap: pretty;
  }

  .faq-index {
    padding-block: var(--space-section);
  }

  .faq-index__head {
    margin-block-end: var(--space-40);
  }

  .faq-index__heading {
    font-family: var(--font-heading);
    font-weight: var(--fw-regular);
    font-size: var(--fs-section);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-tight);
    color: var(--color-heading);
    text-wrap: balance;
    max-width: 20ch;
    margin-block-end: 0;
  }

  /*
    ⚠️ `position: fixed` WITH EXPLICIT OFFSETS, NEVER `absolute`.

    Clicking a `<label>` focuses its input, and focusing an element scrolls it
    into view — so wherever these sit is where the page jumps. As `absolute`
    with no offsets all nineteen resolve to the same point at the top of the
    container, which is what threw the practice-areas rail 440px up the page
    when its sixth tab was clicked. A fixed box is always inside the viewport,
    so there is nothing to scroll to. The offsets are not optional: with
    `top`/`left` auto a fixed box sits at its static position, which is that
    same off-screen point again.
  */
  .faq-radio {
    position: fixed;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* ONE ROW THAT SCROLLS, on the client's instruction — nineteen pills wrap to
     four rows otherwise and push the grid off the first screen. `nowrap` is what
     makes it a rail.

     ⚠️ IT SCROLLS INSIDE THE CONTAINER, NOT TO THE PAGE EDGE. This carried a
     negative inline margin and matching padding so the row bled into the gutter;
     removed on the client's instruction (2026-09-08). The rail now begins and
     ends on the same line as the heading and the grid, so the column edge is
     unbroken down the page.

     `padding-block-end` is the gap between the last pill and the scrollbar. The
     scrollbar sits at the bottom of the scroll box, so this is the only thing
     holding it off the pills — without it the bar runs along their underside and
     reads as a border on them. */
  .faq-filter {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-12);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    margin-block-end: var(--space-40);
    padding-block-end: var(--space-16);
  }

  /* `:global` because the generated rules above are unscoped and set the ACTIVE
     state on these same labels; without it the two blocks select different
     things by the same name. */
  .faq-filter :global(label) {
    flex: none;
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding-inline: var(--space-24);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--white);
    font-family: var(--font-label);
    font-size: var(--fs-14);
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    line-height: var(--lh-label);
    text-transform: uppercase;
    color: var(--body);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .faq-filter :global(label:hover) {
    border-color: var(--border-deep);
  }

  /* The input is off-screen, so the focus ring has to be drawn on the label or
     the pill rail is invisible to the keyboard. */
  .faq-radio:focus-visible ~ .faq-filter :global(label) {
    outline: revert;
  }

  /* Four across, and 16 divides evenly by 4, 2 and 1 — which is why the folds
     below skip three columns. A three-across fold strands one card alone on a
     row at every batch boundary. */
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-28);
  }

  .faq-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--border);
    /* The board's own card: a gold rule across the top, which is the one thing
       distinguishing it from every other panel on the site. */
    border-block-start: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: var(--space-32) var(--space-30);
    color: var(--color-heading);
    text-decoration: none;
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .faq-card:hover {
    border-color: var(--border-deep);
    border-block-start-color: var(--gold);
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  .faq-card__cat {
    font-family: var(--font-label);
    font-size: var(--fs-12);
    font-weight: var(--fw-bold);
    letter-spacing: 0.16em;
    line-height: var(--lh-label);
    text-transform: uppercase;
    color: var(--gold-ink);
    margin-block-end: var(--space-14);
  }

  .faq-card__q {
    font-family: var(--font-heading);
    font-weight: var(--fw-regular);
    font-size: var(--fs-card-title);
    line-height: var(--lh-card);
    text-wrap: pretty;
    margin-block-end: var(--space-18);
  }

  /* Pinned to the foot so the links line up across a row whatever the questions
     do above them. `margin-block-start: auto` on a flex child does not collapse
     the way an ordinary margin would. */
  .faq-card__more {
    margin-block-start: auto;
    font-family: var(--font-label);
    font-size: var(--fs-meta);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--gold-ink);
    transition: color var(--duration) var(--ease);
  }

  .faq-card:hover .faq-card__more {
    color: var(--ink);
  }

  /* The arrow slides on CARD hover, not its own — the whole card is the link, so
     the card is the hover target. */
  .faq-card:hover .arrow,
  .faq-card:focus-visible .arrow {
    transform: translate(0.25em, var(--arrow-shift));
  }

  .faq-more {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-40);
  }

  /* ⚠️ THIS IS NOT REDUNDANT, AND WITHOUT IT THE BUTTON NEVER HIDES. The reset's
     `[hidden] { display: none }` and `.faq-more`'s own `display: flex` have the
     SAME specificity, so source order decides — and this block comes later, so
     the button stayed on screen with nothing left to reveal. Setting `hidden`
     from script looked correct in the DOM the whole time, which is why the
     property read true while the button was plainly visible. `CaseResults.astro`
     documents the same trap. */
  .faq-more[hidden] {
    display: none;
  }

  /* ── The paged state — only ever set by the script ─────────────────────────
     Everything below is inert until `data-paged` lands on the wrapper, so a
     visitor with no JavaScript gets all 180 cards and a working CSS filter
     rather than sixteen cards and a dead button. */
  [data-paged] .faq-card.is-clipped {
    display: none;
  }

  /* The filter animation: a short rise and fade, staggered by position so a
     switch reads as the grid refilling rather than snapping. `--i` is set per
     card and resets every batch, so the stagger never runs away over 180 items. */
  @keyframes faq-card-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [data-paged] .faq-grid.is-filtering .faq-card:not(.is-clipped) {
    animation: faq-card-in 0.32s var(--ease) backwards;
    animation-delay: calc(var(--i, 0) * 18ms);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-paged] .faq-grid.is-filtering .faq-card:not(.is-clipped) {
      animation: none;
    }

    .faq-card:hover {
      transform: none;
    }
  }

  @media (max-width: 1279px) {
    .faq-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-20);
    }

    .faq-card {
      padding: var(--space-26) var(--space-24);
    }
  }
</style>

<script>
  /**
   * The sixteen-at-a-time cap, the "View more" button and the filter animation.
   *
   * THE CATEGORY FILTER ITSELF IS NOT HERE — it is CSS, driven by the radio each
   * pill is a label for, and it works with this script absent. What this adds is
   * the two things CSS cannot do: clip past a cap, and animate a set that
   * changes by `display`. The counts in the pills are rendered at build time and
   * never move, so nothing here has to keep them in step.
   *
   * ⚠️ `data-paged` IS THE SWITCH. The rule that hides clipped cards is scoped to
   * it, so nothing is hidden until this has run to the end. Fail before that
   * point — or never run at all — and the page degrades to every card visible.
   */
  const root = document.querySelector<HTMLElement>("[data-faq-index]");

  if (root) {
    const batch = Number(root.dataset.batch) || 16;
    const grid = root.querySelector<HTMLElement>(".faq-grid");
    const more = root.querySelector<HTMLElement>("[data-faq-more]");
    const button = more?.querySelector("button");
    const radios = [...root.querySelectorAll<HTMLInputElement>(".faq-radio")];
    const cards = [...root.querySelectorAll<HTMLElement>(".faq-card")];

    if (grid && more && button) {
      let shown = batch;

      const active = () => radios.find((radio) => radio.checked)?.value ?? "all";

      const matching = () => {
        const value = active();
        return value === "all" ? cards : cards.filter((card) => card.dataset.cat === value);
      };

      const render = () => {
        const list = matching();

        list.forEach((card, i) => {
          card.classList.toggle("is-clipped", i >= shown);
          // Restart the stagger every batch, or the last card of 180 waits three
          // seconds for its turn.
          card.style.setProperty("--i", String(i % batch));
        });

        more.hidden = list.length <= shown;
      };

      /**
       * ⚠️ THE REFLOW IS LOAD-BEARING. Removing and re-adding a class in the same
       * task is coalesced into no change at all, so the animation never restarts
       * on a second filter click. Reading `offsetWidth` between the two forces
       * the style to flush.
       */
      const replay = () => {
        grid.classList.remove("is-filtering");
        void grid.offsetWidth;
        grid.classList.add("is-filtering");
      };

      radios.forEach((radio) =>
        radio.addEventListener("change", () => {
          shown = batch;
          render();
          replay();
        }),
      );

      button.addEventListener("click", () => {
        shown += batch;
        render();
        replay();
      });

      render();
      root.dataset.paged = "";
    }
  }
</script>
