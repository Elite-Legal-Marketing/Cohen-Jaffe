---
/**
 * `/about/our-community/` — the firm's community involvement.
 *
 * Built from `CJ - Community.dc.html`, MINUS four of its eight sections. The
 * sibling board `CJ - Community Involvement.dc.html` draws the same page
 * differently and is NOT the reference; if someone asks why the page does not
 * match "the community board", that is which one they mean.
 *
 * ⚠️ FOUR SECTIONS WERE CUT ON THE CLIENT'S INSTRUCTION (2026-09-09), and the
 * reasons are worth keeping so nobody restores them from the board:
 *
 *   Photo hero    replaced by the `/faqs/` hero. Interior pages get ONE hero
 *                 treatment, and it is not a photograph.
 *   Breadcrumb    removed site-wide, a decision already taken on 2026-09-08 —
 *                 `/faqs/` records it too. This page reintroduced one from the
 *                 board by mistake. There are no breadcrumbs on this site.
 *   Showcase      the three-card row. It claimed "free legal clinics" and
 *                 printed "know your rights" guides, neither of which appears
 *                 anywhere on the live site or in the 217-page mirror, and its
 *                 three photographs were AI renderings carrying invented
 *                 signage ("COMMUNITY LEGAL AID", "FREE LEGAL RESOURCES",
 *                 and a board reading "COMMUNITY LAW PARTNERS", which is not
 *                 the firm's name). The assets are deleted, not orphaned.
 *   Stats + quote the four claims were a THIRD copy of the homepage's, and the
 *                 closing quote was unsourced and attributed to Stephen Cohen.
 *
 * The URL is the live one. `/about/our-community/` is indexed, it is what
 * `navigation.ts` already carries, and it is where the homepage band's button
 * points — this page is what stops that link 404ing.
 *
 * What remains: hero, intro, organizations, memorial.
 *
 * ⚠️ THE SCHOLARSHIP BAND WAS CUT TOO (2026-09-09). The live
 * `/about/community-scholarship/` page closed applications on 12 June 2026, so
 * the band was advertising a contest nobody can enter; that URL now redirects
 * here in `vercel.json` and its nav item is gone. ⚠️ THE LIVE PAGE STILL SAYS
 * "Each year" — if a 2027 round opens, the redirect and the nav item both have
 * to come back, and this band with them.
 *
 * Cutting it also removed the last of the board's fabricated photographs, the
 * "Scholarship Certificate" made out to a person who does not exist. There are
 * now no invented images on this page.
 *
 * ⚠️ EVERYTHING HERE IS HARDCODED EXCEPT THE ORGANIZATIONS AND THE ONE
 * ATTRIBUTION. AGENTS.md, "Building sections": build it, approve it, then
 * model it. The constants below are shaped the way the projections will return
 * them.
 */
import { sanityClient } from "sanity:client";

import Layout from "../../layouts/Layout.astro";
import { urlFor } from "../../lib/image";
import { COMMUNITY_ATTORNEY_QUERY, ORGANIZATIONS_QUERY } from "../../lib/queries";
import type {
  COMMUNITY_ATTORNEY_QUERY_RESULT,
  ORGANIZATIONS_QUERY_RESULT,
} from "../../sanity/sanity.types";


const [organizations, jaffe] = await Promise.all([
  sanityClient.fetch<ORGANIZATIONS_QUERY_RESULT>(ORGANIZATIONS_QUERY),
  sanityClient.fetch<COMMUNITY_ATTORNEY_QUERY_RESULT>(COMMUNITY_ATTORNEY_QUERY),
]);

const PAGE = {
  /**
   * ⚠️ THE H1 IS THE LIVE PAGE'S H1, VERBATIM (client, 2026-09-09). The board
   * draws "This is our neighborhood too." over the kicker "Our community
   * focus"; the live page uses "Our Community Focus" AS the h1, and that is
   * the string the URL, the nav item, the footer link and the browser title
   * all already say. Matching it means the page answers to one name
   * everywhere instead of four.
   *
   * The board's kicker became the heading, so its heading had to go somewhere
   * or be lost — "Why we show up" moves up from the intro to be the kicker
   * here, which is why the intro below has no kicker of its own.
   */
  eyebrow: "Why we show up",
  heading: "Our Community Focus",
  lead: "Our entire team strives to serve the community through volunteer work in a wide variety of organizations — sometimes with legal help, and just as often with our time.",

  intro: {
    /**
     * ⚠️ THIS REPLACES THE BOARD'S "Fifty years in one community earns you a
     * responsibility to it." — cut 2026-09-09 because "fifty years" returns
     * ZERO hits across the live site and the 217-page mirror. The firm
     * advertises "100 years combined", which is a different claim about
     * different people. The heading now says what the source says.
     */
    heading: "Not all of it is legal work.",
    /**
     * ⚠️ EVERY SENTENCE BELOW IS FROM THE LIVE `/about/our-community/` PAGE,
     * refetched 2026-09-09 and byte-identical to the mirror. It replaces two
     * board paragraphs, one of which was a rewrite of a different page's
     * opening and one of which was invented ("charity rides, toy runs, golf
     * outings, and fundraisers across Nassau, Suffolk, and Queens — most of
     * them run by people we have known for decades").
     *
     * The brief was everything the page carries that the three sections below
     * do NOT: the organizations list covers fifteen names, the memorial covers
     * the fund and the golf outing, the scholarship band covers the contest.
     * What was left is the firm-level commitment, the five organizations that
     * are named on the live page but absent from our collection, and — the
     * best material on the page — what the firm's own people do personally.
     *
     * ⚠️ FIVE ORGANIZATIONS WERE CARRIED HERE IN PROSE FOR ONE COMMIT and are
     * now `organization` documents instead — Holy Family, CMSA Long Island, the
     * All Kids Fair, the Over 50 Fair and the Health & Wellness Fest, moved on
     * the client's instruction (2026-09-09). Do not put them back in this
     * paragraph: the section below prints all twenty.
     *
     * ⚠️ MARIA FIORE IS A NAMED REAL PERSON and a paralegal, not an attorney.
     * The live page names her; if she leaves the firm this line goes with her.
     */
    body: [
      "The attorneys and staff at the Law Office of Cohen & Jaffe are committed to the Long Island communities where we live and work. Some of that service is legal. Much of it is not — it goes to health, to youth development, and to the families who need the help most.",
      "Richard Jaffe has served as a volunteer firefighter and medic with the Jericho Fire Department and as a medic for Brentwood Legion Ambulance. He has coached basketball for the Jericho Athletic Association and lacrosse at the Jericho Lacrosse Club, and he helped victims of 9/11 through Trial Lawyers Care. He still volunteers as a small claims court arbitrator and sits as a mediator for the Supreme Court of New York.",
      "It is not only the attorneys. Paralegal Maria Fiore volunteers at her church’s food pantry, and the firm has given to the Tuberous Sclerosis Alliance for every like its Facebook page received.",
      "We represent injured people and people who have suffered discrimination at work, so a good deal of our practice is already spent improving lives in this community. The rest is what our attorneys and staff do with their own time.",
    ],
    /**
     * ⚠️ BOTH OF THESE ARE REAL AND VERBATIM, which is worth recording because
     * so much of this board is not. They are on the live
     * `/about/community-scholarship/` page, where the firm prints them as
     * Richard Jaffe's own words. Unlike the homepage's "Our goals" pull quote
     * and the FAQs band's, these need no confirming.
     */
    quote: "Community service represents a critical aspect of our firm.",
    quoteBody:
      "To further extend our commitment to giving back to the community, we want to help today’s young volunteers succeed in their academic and professional pursuits. When they venture out into their own careers, they will, in a way, be continuing our legacy.",
  },

  organizations: {
    eyebrow: "Organizations we support",
    heading: "Where our time and money go.",
    /**
     * ⚠️ REPLACES the board's "Some of these we have supported for twenty
     * years. Others started with a client who told us about a group that
     * needed help, and we showed up." Both sentences were invented — nothing
     * in the mirror dates any of these relationships, and no client is
     * recorded as having introduced one. This is the live page's own framing
     * of the same list.
     */
    lead: "A small sample of the many ways our attorneys and staff give their time to help make Long Island a better place.",
  },

  /**
   * The in-memoriam panel. Every fact here is on the live
   * `/about/our-community/` page: the 2014 accident, both children, their
   * ages, the grandmother, and the outing at Pine Hollow. The board's own
   * wording is kept because it is accurate to that account.
   */
  memorial: {
    eyebrow: "In memoriam",
    heading: "The Reagan and Jax Memorial Golf Outing",
    body: "Held each year at Pine Hollow Country Club in East Norwich, the outing is a memorial to Stephen Cohen’s two grandchildren — three-year-old Reagan Cohen and eighteen-month-old Jaxson Cohen — who died in an ATV accident while visiting their grandparents in 2014. The children’s grandmother, Renee Monroe, died in the accident as well.",
    /**
     * ⚠️ UNSOURCED, and attributed to the firm rather than to a person, which
     * is the only reason it is less serious than the board's other inventions.
     * It is still a sentence nobody at Cohen & Jaffe is recorded as having
     * said, printed beneath an account of a real family's bereavement.
     */
    pullQuote:
      "Every family we represent has lost something. Ours is no different, and it is why we do not treat any of this as routine.",
    note: "Proceeds from the outing support the causes the family cares about most, including organizations serving children and families in crisis on Long Island.",
    /**
     * The fund's own site, and the same target and label the homepage band
     * uses — this page had been describing the fund at length with no way to
     * reach it. It is what the live `/about/our-community/` page links the
     * words "Reagan and Jax Cohen Memorial Fund" to.
     */
    href: "https://www.reaganjax.memorial/",
  },

};

/**
 * The organizations, split into the board's three cards.
 *
 * ⚠️ THE BOARD'S CATEGORY HEADINGS ARE NOT HERE, and their absence is the
 * decision. The board labels its three cards "Children & families", "Health &
 * awareness" and "Veterans & first responders" — but those were drawn against
 * the client's own list of organizations, and the fifteen we publish come from
 * the live page instead (the client's call, 2026-09-09). The two lists overlap
 * on FOUR entries. An arts centre, a film festival and a running club belong
 * to none of the three headings, so filling them would mean inventing a
 * taxonomy to justify a label.
 *
 * What survives is the board's SHAPE: three cards, five to a card, in the
 * query's alphabetical order — so the columns read down and then across, the
 * way a single list would if you cut it in three.
 */
const COLUMNS = 3;
const perColumn = Math.ceil(organizations.length / COLUMNS);
const organizationColumns = Array.from({ length: COLUMNS }, (_, i) =>
  organizations.slice(i * perColumn, (i + 1) * perColumn),
).filter((column) => column.length > 0);
---

{/* ⚠️ EVERY SECTION DECLARES ITS OWN GROUND, and they alternate deliberately
    (client, 2026-09-09): forest-deep hero, sand, cream, sand, then the footer's
    forest gradient. No two neighbours share a background. `surface-cream` on
    the causes band is the page default and therefore redundant — it is written
    anyway so the alternation can be read off the markup instead of inferred
    from what is missing, which is how the intro and the causes band came to be
    the same colour in the first place. Inserting a section means re-checking
    its two neighbours. */}
<Layout
  title="Our Community Focus"
  description="The Long Island charities, clubs and causes the Law Office of Cohen & Jaffe supports — and why we show up."
>
  <section class="page-hero surface-forest-deep">
    <div class="container">
      <div class="page-hero__copy">
        <p class="eyebrow">{PAGE.eyebrow}</p>
        <h1 class="page-hero__title">{PAGE.heading}</h1>
        <p class="page-hero__lead">{PAGE.lead}</p>
      </div>
    </div>
  </section>

  <section class="intro section surface-sand" aria-labelledby="intro-heading">
    <div class="container intro__grid">
      {/* ⚠️ NO KICKER HERE — "Why we show up" is the HERO's kicker now. Two
          children, so the quote card and the heading are both in the grid's
          only row and their tops line up with no placement rules at all. The
          three-child, two-row structure this replaced existed solely to push
          the card past a kicker that is no longer here; `.memorial__panel`
          still needs it, and still has it. */}
      <div class="intro__copy">
        <h2 id="intro-heading" class="intro__heading">{PAGE.intro.heading}</h2>
        {PAGE.intro.body.map((paragraph) => <p class="intro__body">{paragraph}</p>)}
      </div>

      <figure class="quote-card">
        <blockquote class="quote-card__lead">“{PAGE.intro.quote}”</blockquote>
        <p class="quote-card__body">“{PAGE.intro.quoteBody}”</p>
        {
          jaffe && (
            <figcaption class="quote-card__by">
              {jaffe.portrait && (
                <img
                  class="quote-card__portrait"
                  src={urlFor(jaffe.portrait).width(128).height(128).url()}
                  alt=""
                  width="64"
                  height="64"
                  loading="lazy"
                />
              )}
              <span>
                <span class="quote-card__name">{jaffe.name}</span>
                {jaffe.role && <span class="eyebrow eyebrow--bare quote-card__role">{jaffe.role}</span>}
              </span>
            </figcaption>
          )
        }
      </figure>
    </div>
  </section>

  <section class="causes section surface-cream" aria-labelledby="causes-heading">
    <div class="container">
      <header class="causes__head">
        <div>
          <p class="eyebrow">{PAGE.organizations.eyebrow}</p>
          <h2 id="causes-heading" class="causes__heading">{PAGE.organizations.heading}</h2>
        </div>
        <p class="causes__lead">{PAGE.organizations.lead}</p>
      </header>

      <div class="causes__grid">
        {
          organizationColumns.map((column) => (
            <ul class="causes__card" role="list">
              {column.map((org) => (
                <li class="cause">
                  <p class="cause__name">
                    {org.href ? (
                      <a href={org.href} target="_blank" rel="noopener noreferrer">
                        {org.name}
                      </a>
                    ) : (
                      org.name
                    )}
                  </p>
                  {org.note && <p class="cause__note">{org.note}</p>}
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>

  <section class="memorial section surface-sand" aria-labelledby="memorial-heading">
    <div class="container">
      {/* Same three-child, two-row structure as the intro, and for the same
          reason: the pull quote lines up with the heading, not with the
          "In memoriam" kicker above it. */}
      <div class="memorial__panel">
        <p class="eyebrow eyebrow--bare memorial__eyebrow">{PAGE.memorial.eyebrow}</p>

        <div class="memorial__copy">
          <h2 id="memorial-heading" class="memorial__heading">{PAGE.memorial.heading}</h2>
          <p class="memorial__body">{PAGE.memorial.body}</p>
        </div>

        <div class="memorial__aside">
          <p class="memorial__quote">{PAGE.memorial.pullQuote}</p>
          <hr class="memorial__rule" />
          <p class="memorial__note">{PAGE.memorial.note}</p>
          <p class="memorial__link">
            <a
              class="link-arrow"
              href={PAGE.memorial.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              About the fund
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* --- Hero ----------------------------------------------------------------

     ⚠️ THIS IS THE `/faqs/` HERO, COPIED. The photo band the board draws was
     replaced on the client's instruction (2026-09-09): interior pages get one
     hero treatment, and this is it — forest-deep, no photograph, copy at the
     container's left.

     ⚠️ COPIED RATHER THAN SHARED, and that is a liability worth naming. Two
     pages now carry these rules verbatim, including the tablet override and
     its measured `* 1.5`. The repo's own bar for promotion is the second
     consumer — `.toggle` came out of `About.astro` at exactly this point — so
     this belongs in `global.css` as `.page-hero`. Not done here because it
     means editing a shipped page; raised.
   */

  .page-hero {
    display: flex;
    align-items: center;
    min-height: 420px;
    padding-block: var(--space-xl);
  }

  .page-hero__copy {
    max-width: 1000px;
  }

  .page-hero__title {
    font-family: var(--font-heading);
    font-weight: var(--fw-regular);
    font-size: var(--fs-page-title);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-display);
    color: var(--on-dark);
    text-wrap: balance;
    margin-block-end: var(--space-22);
  }

  .page-hero__lead {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--on-dark-80);
    max-width: var(--container-prose);
    text-wrap: pretty;
  }

  /* --- Intro --------------------------------------------------------------- */

  .intro__grid {
    display: grid;
    grid-template-columns: 1fr 640px;
    gap: var(--space-xl);
    align-items: start;
  }

  .intro__heading {
    font-size: var(--fs-52);
    line-height: var(--lh-tight);
    margin-block-end: var(--space-28);
  }

  /* The reset zeroes paragraph margins site-wide and `.prose` is for authored
     long-form, not a designed two-column band — so the gap is owned here. */
  .intro__body + .intro__body {
    margin-block-start: var(--space-22);
  }

  .intro__body {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
  }

  .quote-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-block-start: 3px solid var(--gold);
    border-radius: var(--radius-lg);
    padding: var(--space-40) var(--space-44);
  }

  .quote-card__lead {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--fs-28);
    line-height: var(--lh-card);
    color: var(--color-heading);
    margin-block-end: var(--space-24);
  }

  .quote-card__body {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    margin-block-end: var(--space-24);
  }

  .quote-card__by {
    display: flex;
    align-items: center;
    gap: var(--space-18);
    padding-block-start: var(--space-22);
    border-block-start: 1px solid var(--border);
  }

  .quote-card__portrait {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    object-fit: cover;
    object-position: 50% 18%;
    flex: none;
  }

  .quote-card__name {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--fs-24);
    line-height: var(--lh-card);
    color: var(--color-heading);
  }

  .quote-card__role {
    display: block;
    font-size: var(--fs-meta);
    margin-block: var(--space-4) 0;
  }

  /* --- Causes -------------------------------------------------------------- */

  .causes__head {
    display: grid;
    grid-template-columns: 1fr 700px;
    gap: var(--space-xl);
    align-items: end;
    padding-block-end: var(--space-md);
    border-block-end: 1px solid var(--border-strong);
    margin-block-end: var(--space-lg);
  }

  .causes__heading {
    font-size: var(--fs-52);
    line-height: var(--lh-tight);
    margin-block-end: 0;
  }

  .causes__lead {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--muted-2);
  }

  .causes__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-20);
  }

  .causes__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-22);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  .cause__name {
    font-family: var(--font-heading);
    font-size: var(--fs-23);
    line-height: var(--lh-snug);
    color: var(--color-heading);
    margin-block-end: var(--space-6);
  }

  /* Same fade-up underline as every other link on the site:
     `text-decoration-line` cannot be transitioned, so it is declared at rest
     with a transparent colour and the COLOUR is what animates. */
  .cause__name a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: transparent;
    transition: color var(--duration) var(--ease),
      text-decoration-color var(--duration) var(--ease);
  }

  .cause__name a:hover {
    color: var(--gold-ink);
    text-decoration-color: currentColor;
  }

  .cause__note {
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--muted);
  }

  /* --- Memorial ------------------------------------------------------------ */

  /* `column-gap` only — see the note on `.intro__grid`. */
  .memorial__panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-xl);
    align-items: start;
    background: var(--white);
    border: 1px solid var(--border);
    border-block-start: 3px solid var(--gold);
    border-radius: var(--radius-lg);
    padding: var(--space-60) var(--space-80);
  }

  .memorial__eyebrow {
    grid-column: 1;
    grid-row: 1;
  }

  .memorial__copy {
    grid-column: 1;
    grid-row: 2;
  }

  .memorial__aside {
    grid-column: 2;
    grid-row: 2;
  }

  .memorial__eyebrow {
    margin-block-end: var(--space-18);
  }

  /* ⚠️ `--fs-46` DOES NOT EXIST. The ramp steps 42 -> 48 and the board sets
     these two panel headings at 46, so this is the nearest real token rather
     than an invented one — an undefined custom property falls back silently to
     the inherited size, which is how a heading ends up at body size with no
     error anywhere. A one-page token was the alternative and is not worth a
     2px difference at the desktop end. */
  .memorial__heading {
    font-size: var(--fs-48);
    line-height: var(--lh-heading);
    margin-block-end: var(--space-22);
  }

  .memorial__body {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    text-wrap: pretty;
  }

  .memorial__quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--fs-26);
    line-height: var(--lh-card);
    color: var(--color-heading);
  }

  .memorial__rule {
    border: 0;
    border-block-start: 1px solid var(--border);
    margin-block: var(--space-26);
  }

  .memorial__note {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--muted-2);
  }

  .memorial__link {
    margin-block-start: var(--space-26);
  }

  /* --- Responsive -----------------------------------------------------------
     Structure only; type and spacing already ramp through clamp(). */

  /* The 420px floor and the full `--space-xl` are drawn for a board where the
     heading sits on one line; below tablet it wraps and the floor stops doing
     anything, so the padding would stack on copy that is already tall. The
     `* 1.5` is the measured middle `/faqs/` arrived at — see its docblock for
     why it is deliberately larger than the desktop padding. */
  @media (max-width: 1023px) {
    .page-hero {
      min-height: 0;
      padding-block: calc(var(--space-lg) * 1.5);
    }
  }

  @media (max-width: 639px) {
    .page-hero {
      padding-block: calc(var(--space-md) * 1.5);
    }
  }

  /* ⚠️ EXPLICIT PLACEMENT MUST BE UNDONE WHEN THE GRID COLLAPSES. Leaving
     `grid-row: 2` on the card in a one-column grid parks it beside the copy in
     a phantom second column and leaves row 1 half empty. `auto` hands the
     three children back to normal flow order, and the row gap comes back
     because the heading's margin no longer separates two columns. */
  @media (max-width: 1279px) {
    .intro__grid,
    .causes__head {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .memorial__panel {
      padding: var(--space-md);
    }
  }

  @media (max-width: 1023px) {
    .memorial__panel {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .memorial__eyebrow,
    .memorial__copy,
    .memorial__aside {
      grid-column: 1;
      grid-row: auto;
    }

    /* ⚠️ ROW GAP 0, AND THE ASIDE CARRIES ITS OWN. In one column the grid's
       row gap ADDS to the kicker's own margin, so "In memoriam" sat 54px off
       its heading where the design wants 18 — margin doubling against gap,
       arriving through a responsive collapse rather than a component. Zeroing
       the kicker instead would lose the tight kicker-to-heading pairing, so
